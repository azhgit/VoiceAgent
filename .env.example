# --- Voice AI services ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Fallback only if Haiku fumbles tool-calling/urgency judgment (see plan doc): claude-sonnet-5

DEEPGRAM_API_KEY=

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 is Pipecat's own lowest-latency default, matching this
# project's latency-first model-selection decision. Confirm pricing/quality
# against your ElevenLabs account before Day 2 latency tuning.
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Mock CRM ---
DATABASE_URL=sqlite:///./crm.db
CRM_BASE_URL=http://localhost:8000
# Read by agent/bot.py's check_availability/book_appointment tools to call
# the mock CRM's HTTP API.
CRM_API_KEY=
# Shared secret between agent/bot.py and crm/main.py (crm/auth.py) - must be
# set to the same value on both sides, or the CRM rejects every request.

# --- VAD tuning (Day 2, optional) ---
# Silero's own defaults apply if unset (confidence=0.7, start_secs=0.2,
# stop_secs=0.2). Untuned for 8kHz phone audio - adjust based on real test
# call behavior, see agent/bot.py's _vad_params_from_env.
VAD_CONFIDENCE=
VAD_START_SECS=
VAD_STOP_SECS=
